#GLOBAL ARGS
ARG RHEL_OS_VERSION=9.6

# BASE IMAGE
FROM docker.io/redhat/ubi9:${RHEL_OS_VERSION}

# BUILD ARGS
ARG PYTORCH_REPO=https://github.com/pytorch/pytorch
ARG PYT_BRANCH=main
ARG COMMIT_HASH=""
ARG OS_TYPE=x86_64
ARG PY_VER=3.12
ARG CONDA_VER=latest
ARG CONDA_ENV="rocm_torch_build"
ARG ENABLE_SUBSCRIPTION=false
ARG ROCM_VERSION=6.3

# Register the system using BuildKit secret mount — credentials never
# appear in build args, image layers, or docker history.
RUN --mount=type=secret,id=subscription_key \
    --mount=type=secret,id=subscription_org \
    if [ "${ENABLE_SUBSCRIPTION}" = "true" ]; then \
        ACTIVATION_KEY=$(cat /run/secrets/subscription_key 2>/dev/null) && \
        ORG_ID=$(cat /run/secrets/subscription_org 2>/dev/null) && \
        if [ -z "${ACTIVATION_KEY}" ] || [ -z "${ORG_ID}" ]; then \
            echo "ERROR: subscription secrets not provided" && exit 1; \
        fi && \
        subscription-manager register \
            --activationkey="${ACTIVATION_KEY}" \
            --org="${ORG_ID}" && \
        unset ACTIVATION_KEY ORG_ID; \
    fi

# Add EPEL repo for jemalloc
RUN dnf -y install https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm

# Install system packages required for a PyTorch ROCm source build
RUN dnf install -y --allowerasing \
    wget \
    jq \
    vim \
    git \
    gdb \
    unzip \
    which \
    libffi-devel \
    openssl-devel \
    gcc \
    gcc-c++ \
    make \
    cmake \
    ninja-build \
    lld \
    openblas \
    openblas-devel \
    environment-modules \
    findutils \
    curl \
    sudo \
    perl \
    zlib-devel \
    gcc-gfortran \
    jemalloc \
    xz \
    bzip2 && \
    dnf clean all

# Install miniconda
RUN wget --no-check-certificate https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-${OS_TYPE}.sh && \
    bash Miniforge3-Linux-${OS_TYPE}.sh -p /miniconda -b && \
    rm Miniforge3-Linux-${OS_TYPE}.sh && \
    /miniconda/bin/conda update -y conda && \
    /miniconda/bin/conda init && \
    /miniconda/bin/conda create -n ${CONDA_ENV} python=${PY_VER} pip -y

ENV PATH=/miniconda/bin:${PATH}

# Install OpenMPI via conda (UBI9 repos don't ship openmpi-devel)
RUN source /miniconda/etc/profile.d/conda.sh && \
    conda activate ${CONDA_ENV} && \
    conda install -y conda-forge::openmpi

# Install ROCm from AMD RHEL9 repositories
# Docs: https://rocm.docs.amd.com/projects/install-on-linux/
RUN tee /etc/yum.repos.d/rocm.repo <<REPO
[ROCm-${ROCM_VERSION}]
name=ROCm${ROCM_VERSION}
baseurl=https://repo.radeon.com/rocm/rhel9/${ROCM_VERSION}/main
enabled=1
priority=50
gpgcheck=1
gpgkey=https://repo.radeon.com/rocm/rocm.gpg.key
REPO
RUN dnf install -y \
    rocm-dev \
    rocm-libs \
    rocm-utils \
    rccl \
    rocprofiler-dev \
    roctracer-dev \
    hip-devel \
    hipblas-devel \
    hipsparse-devel \
    hipfft-devel \
    rocblas-devel \
    miopen-hip-devel \
    amd-smi \
    && dnf clean all \
    && ln -sfn /opt/rocm-${ROCM_VERSION}* /opt/rocm || ln -sfn /opt/rocm /opt/rocm

# Create libgomp.so linker symlink (UBI9 only ships libgomp.so.1)
RUN ln -sf /usr/lib64/libgomp.so.1 /usr/lib64/libgomp.so

# Clone PyTorch and checkout specific commit/branch if required
RUN git clone ${PYTORCH_REPO} /pytorch && \
    cd /pytorch && \
    git checkout ${PYT_BRANCH} && \
    if [ -n "${COMMIT_HASH}" ]; then \
        echo "Checking out specific commit: ${COMMIT_HASH}" && \
        git checkout ${COMMIT_HASH}; \
    fi && \
    git submodule sync && \
    git submodule update --init --recursive

ENV OpenBLAS_HOME=/usr/lib64:{OpenBLAS_HOME}
ENV MAX_JOBS=56
ENV CMAKE_LINKER="lld"
ENV LDFLAGS="-fuse-ld=lld"
ENV CMAKE_EXPORT_COMPILE_COMMANDS=ON
ENV CFLAGS="-mf16c -mavx2"
ENV CXXFLAGS="-mf16c -mavx2"
ENV USE_MPI=1
ENV USE_SYSTEM_MPI=1

# ROCm build flags — CUDA is explicitly disabled
ENV USE_CUDA=0
ENV USE_ROCM=1
ENV ROCM_HOME=/opt/rocm
ENV PATH=/opt/rocm/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:${LD_LIBRARY_PATH}

WORKDIR /pytorch

# Optional GPU arch list for the runner's AMD GPUs (override at build time)
ARG PYTORCH_ROCM_ARCH="gfx90a;gfx942"
ENV PYTORCH_ROCM_ARCH=${PYTORCH_ROCM_ARCH}

# Install dependencies and build PyTorch with ROCm
RUN source /miniconda/etc/profile.d/conda.sh && \
    conda activate ${CONDA_ENV} && \
    conda install -y -c conda-forge libstdcxx-ng && \
    pip install -r .ci/docker/requirements-ci.txt && \
    pip install --group dev && \
    pip install mkl-static mkl-include && \
    export CMAKE_PREFIX_PATH="${CONDA_PREFIX:-'$(dirname $(which conda))/../'}:${CMAKE_PREFIX_PATH}" && \
    echo "Building with USE_ROCM=1 USE_CUDA=0 PYTORCH_ROCM_ARCH=${PYTORCH_ROCM_ARCH}" && \
    .ci/pytorch/build.sh

# Set default conda environment for interactive use
ENV CONDA_DEFAULT_ENV=${CONDA_ENV}
RUN echo "conda activate ${CONDA_ENV}" >> ~/.bashrc
